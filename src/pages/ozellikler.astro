---
import Layout from "../layouts/Layout.astro";
import OzellikBolumu from "../components/OzellikBolumu.astro";
import { ozellikler } from "../data/ozellikler.js";
---

<Layout
  title="Özellikler — İnteraktif Harita, Katman Yönetimi, TUCBS | Piramittek CBS"
  description="Piramittek CBS'nin özellikleri: interaktif harita, katman yönetimi, veri kalitesi, TUCBS uyumu, hızlı vektör karo (MVT) altyapısı ve kurum sunucusunda barındırma."
>
  <div class="icerik">
    <header class="sayfa-basi">
      <span class="ustbaslik">Özellikler</span>
      <h1>CBS'yi oluşturan <em>altı yapı taşı</em></h1>
      <p>
        İnteraktif haritadan veri kalitesine, ulusal standart uyumundan kurum içi
        barındırmaya kadar sistemin her parçası aşağıda kendi bölümünde anlatılıyor.
      </p>
    </header>

    {ozellikler.map((ozellik) => <OzellikBolumu ozellik={ozellik} />)}
  </div>
</Layout>

<style>
  .sayfa-basi {
    max-width: 720px;
    padding-block: var(--bosluk-8) var(--bosluk-6);
  }

  .ustbaslik {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--renk-vurgu);
    margin-bottom: 18px;
  }
  .ustbaslik::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--renk-vurgu);
    border-radius: 2px;
  }

  h1 {
    font-weight: 700;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--renk-metin);
  }
  h1 em {
    font-style: italic;
    font-weight: 600;
    color: var(--renk-vurgu);
  }

  .sayfa-basi p {
    margin-top: 18px;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--renk-metin-silik);
    max-width: 56ch;
    text-wrap: pretty;
  }
</style>
