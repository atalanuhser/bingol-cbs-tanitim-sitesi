---
// Değer önerileri bölümü — içerik src/data/mesajlar.js'ten döngüyle gelir.
// İkonlar Lucide setinden inline SVG kopyası (dış CDN yok, CLAUDE.md kural 6).
// Sıra mesajlar.js dizisiyle birebir eşleşir.
import { mesajlar } from "../data/mesajlar.js";

const ikonlar = [
  // 1) tek haritada → map
  `<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>`,
  // 2) katman yönetimi → layers
  `<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>`,
  // 3) hızlı harita (MVT) → zap
  `<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>`,
  // 4) veri kurumda → server
  `<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>`,
  // 5) TUCBS uyumu → shield-check
  `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`,
  // 6) veri kalitesi → search-check
  `<path d="m8 11 2 2 4-4"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>`,
];
---

<section class="mesajlar icerik" aria-labelledby="mesajlar-baslik">
  <h2 id="mesajlar-baslik">CBS belediyenize ne sağlar?</h2>
  <div class="kartlar">
    {
      mesajlar.map((mesaj, i) => (
        <article class="kart">
          <div class="ikon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={ikonlar[i]}
            />
          </div>
          <h3>{mesaj.baslik}</h3>
          <p>{mesaj.aciklama}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .mesajlar {
    padding-block: var(--bosluk-8);
    text-align: center;
  }

  h2 {
    margin-bottom: var(--bosluk-7);
  }

  .kartlar {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bosluk-5);
    text-align: left;
  }

  .kart {
    background: var(--renk-yuzey);
    border: 1px solid var(--renk-cizgi);
    border-radius: var(--kose);
    box-shadow: var(--golge-kart);
    padding: var(--bosluk-6);
  }

  .ikon {
    display: inline-flex;
    padding: var(--bosluk-3);
    border-radius: var(--kose-kucuk);
    background: var(--renk-vurgu-acik);
    color: var(--renk-vurgu);
    margin-bottom: var(--bosluk-4);
  }

  .kart h3 {
    margin-bottom: var(--bosluk-3);
  }

  .kart p {
    color: var(--renk-metin-soluk);
    font-size: var(--boyut-kucuk);
  }

  @media (min-width: 640px) {
    .kartlar {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .kartlar {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
