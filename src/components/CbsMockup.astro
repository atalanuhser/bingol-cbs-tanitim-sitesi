---
// CbsMockup — stilize CBS arayüzü. Gerçek sistem ekran görüntüsü DEĞİLDİR;
// temiz ve modern bir temsil hedeflenir (CLAUDE.md).
// Kaynak: notlar/cbs-arastirma-notlari.md §7 (CBS arayüz kalıpları).
// Varyantlar:
//   katmanlar       → checkbox'lı katman paneli + harita
//   bilgi-penceresi → haritada seçili nesne + açık öznitelik kartı
//   genel           → arama kutusu + yakınlaştırma araçları + durum çubuğu
const { variant = "genel" } = Astro.props;

// Panel içeriği — işaretli olmayan katman haritada da çizilmez (tutarlılık).
const katmanlar = [
  {
    ad: "Atıksu Şebekesi",
    renk: "var(--renk-katman-1)",
    acik: true,
    altlar: ["Ana kolektör", "Tali hat"],
  },
  { ad: "İmar Planı", renk: "var(--renk-katman-2)", acik: true, altlar: [] },
  { ad: "Mahalle Sınırları", renk: "var(--renk-katman-3)", acik: true, altlar: [] },
  { ad: "İçme Suyu", renk: "var(--renk-katman-4)", acik: false, altlar: [] },
  { ad: "Binalar", renk: "var(--renk-harita-metin-soluk)", acik: false, altlar: [] },
];

// Öznitelik kartı içeriği (bilgi-penceresi) — tüm değerler temsilîdir.
const oznitelikler = [
  ["Boru çapı", "Ø300 mm"],
  ["Uzunluk", "184 m"],
  ["Kaynak", "Saha ölçümü (GPS)"],
  ["TUCBS sınıfı", "Altyapı › Atıksu Hattı"],
  ["İlişkili kayıt", "3 bakım işi"],
];

const etiketler = {
  katmanlar:
    "Stilize CBS arayüzü örneği: solda açılıp kapanabilir katman listesi, koyu harita alanında atıksu hatları, imar planı ve mahalle sınırı katmanları",
  "bilgi-penceresi":
    "Stilize CBS arayüzü örneği: haritada seçili bir atıksu hattı ve açık öznitelik kartında boru çapı, uzunluk, veri kaynağı ile TUCBS sınıfı bilgileri",
  genel:
    "Stilize CBS arayüzü örneği: üstte ada-parsel arama kutusu, sağda yakınlaştırma araçları, altta koordinat sistemi ve veri güncelliği durum çubuğu",
};
---

<figure class="mockup" role="img" aria-label={etiketler[variant] ?? etiketler.genel}>
  <div class="bar">
    <span class="nokta"></span> Kent Haritası
    <span class="bar-sag">güncel</span>
  </div>

  <div class:list={["govde", { panelli: variant === "katmanlar" }]}>
    {
      variant === "katmanlar" && (
        <aside class="panel">
          <div class="panel-baslik">Katmanlar</div>
          {katmanlar.map((katman) => (
            <>
              <div class:list={["katman", { kapali: !katman.acik }]}>
                <span class="kutu">
                  {katman.acik && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  )}
                </span>
                <span class="renk" style={`--katman-renk:${katman.renk}`} />
                <span class="ad">{katman.ad}</span>
              </div>
              {katman.altlar.map((alt, i) => (
                <div class="alt-sinif">
                  <span class="ornek" style={`--katman-renk:${katman.renk}; --kalinlik:${i === 0 ? "3px" : "1.5px"}`} />
                  <span>{alt}</span>
                </div>
              ))}
            </>
          ))}
        </aside>
      )
    }

    <div class="harita">
      {
        variant === "genel" && (
          <div class="arama">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span>Ada / parsel veya adres ara…</span>
          </div>
        )
      }
      {
        variant === "genel" && (
          <div class="araclar">
            <span>+</span>
            <span>−</span>
          </div>
        )
      }

      <svg viewBox="0 0 640 420" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <rect width="640" height="420" fill="var(--renk-harita-zemin)"/>

        <!-- ince harita ızgarası -->
        <g stroke="var(--renk-izgara)" stroke-width="1">
          <path d="M0 84 H640"/><path d="M0 168 H640"/><path d="M0 252 H640"/><path d="M0 336 H640"/>
          <path d="M107 0 V420"/><path d="M214 0 V420"/><path d="M320 0 V420"/><path d="M427 0 V420"/><path d="M534 0 V420"/>
        </g>

        <!-- KATMAN: imar planı (amber poligonlar) -->
        <g fill="var(--renk-katman-2)" stroke="var(--renk-katman-2)" stroke-width="1.5">
          <path d="M60 70 L185 48 L215 128 L92 152 Z" opacity="0.22"/>
          <path d="M255 165 L390 142 L425 235 L288 262 Z" opacity="0.18"/>
          <path d="M430 55 L555 72 L538 148 L418 130 Z" opacity="0.22"/>
          <path d="M120 260 L235 245 L258 330 L142 348 Z" opacity="0.15"/>
        </g>

        <!-- KATMAN: mahalle sınırı (mor kesikli) -->
        <path d="M30 390 C 120 330, 150 250, 250 230 C 360 208, 420 250, 520 200 C 580 170, 610 120, 635 100"
              fill="none" stroke="var(--renk-katman-3)" stroke-width="2.5" stroke-dasharray="10 7" opacity="0.85"/>

        <!-- KATMAN: atıksu şebekesi (turkuaz) — ana kolektör + tali hatlar -->
        <g fill="none" stroke="var(--renk-katman-1)" stroke-linecap="round">
          <path d="M20 210 C 120 190, 210 235, 320 210 S 540 160, 630 185" stroke-width="4"/>
          <path d="M175 215 C 190 160, 205 120, 240 85" stroke-width="2"/>
          <path d="M320 210 C 335 265, 350 300, 395 340" stroke-width="2"/>
          <path d="M480 190 C 495 150, 520 120, 560 100" stroke-width="2"/>
        </g>
        <g fill="var(--renk-harita-zemin)" stroke="var(--renk-katman-1)" stroke-width="2.5">
          <circle cx="175" cy="215" r="6"/>
          <circle cx="320" cy="210" r="6"/>
          <circle cx="480" cy="190" r="6"/>
        </g>

        {
          variant === "bilgi-penceresi" && (
            <g>
              <!-- seçili nesne vurgusu: amber halka + seçim parlaması -->
              <path d="M20 210 C 120 190, 210 235, 320 210" fill="none" stroke="var(--renk-cta)" stroke-width="5" stroke-linecap="round" opacity="0.9" />
              <circle cx="320" cy="210" r="11" fill="none" stroke="var(--renk-cta)" stroke-width="2.5" />
              <circle cx="320" cy="210" r="6" fill="var(--renk-cta)" />
              <path d="M320 199 L320 132" stroke="var(--renk-cta)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.7" />
            </g>
          )
        }
      </svg>

      {
        variant === "bilgi-penceresi" && (
          <div class="bilgi-karti">
            <div class="bilgi-baslik">
              <span class="bilgi-nokta" />
              Atıksu Hattı · AS-1042
            </div>
            <dl>
              {oznitelikler.map(([etiket, deger]) => (
                <div class="satir">
                  <dt>{etiket}</dt>
                  <dd>{deger}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </div>

  {
    variant === "genel" && (
      <div class="durum">
        <span>EPSG:5256 · TUREF</span>
        <span class="durum-guncel">
          <span class="durum-nokta" /> Veri güncel
        </span>
        <span class="olcek">
          <span class="olcek-cizgi" /> 200 m
        </span>
      </div>
    )
  }
</figure>

<style>
  .mockup {
    margin: 0;
    background: var(--renk-harita-yuzey);
    border: 1px solid var(--renk-harita-cizgi);
    border-radius: var(--kose-orta);
    overflow: hidden;
    box-shadow: var(--golge-vitrin);
  }

  /* üst bar — hero'daki harita kartıyla aynı dil */
  .bar {
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    padding: var(--bosluk-3) var(--bosluk-4);
    border-bottom: 1px solid var(--renk-harita-cizgi);
    color: var(--renk-harita-metin-soluk);
    font-size: var(--boyut-kucuk);
  }
  .nokta {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--renk-katman-1);
  }
  .bar-sag {
    margin-left: auto;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--renk-katman-1);
  }

  .govde {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* ---- katman paneli ---- */
  .panel {
    padding: var(--bosluk-4);
    border-bottom: 1px solid var(--renk-harita-cizgi);
    font-size: 0.8125rem; /* 13px */
    color: var(--renk-harita-metin);
  }
  .panel-baslik {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--renk-harita-metin-soluk);
    margin-bottom: var(--bosluk-3);
  }
  .katman {
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    padding-block: var(--bosluk-2);
  }
  .katman.kapali {
    opacity: 0.45;
  }
  .kutu {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--renk-harita-cizgi);
    border-radius: 4px;
    color: var(--renk-harita-zemin);
    flex-shrink: 0;
  }
  .katman:not(.kapali) .kutu {
    background: var(--renk-katman-1);
    border-color: var(--renk-katman-1);
  }
  .kutu svg {
    width: 10px;
    height: 10px;
  }
  .renk {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--katman-renk);
    flex-shrink: 0;
  }
  .ad {
    white-space: nowrap;
  }
  .alt-sinif {
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    padding: var(--bosluk-1) 0 var(--bosluk-1) calc(15px + var(--bosluk-2) * 2 + 9px);
    font-size: 0.72rem;
    color: var(--renk-harita-metin-soluk);
  }
  .ornek {
    width: 18px;
    height: var(--kalinlik);
    border-radius: 2px;
    background: var(--katman-renk);
    flex-shrink: 0;
  }

  /* ---- harita alanı ---- */
  .harita {
    position: relative;
  }
  .harita > svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
  }

  /* ---- bilgi-penceresi: öznitelik kartı ---- */
  .bilgi-karti {
    position: absolute;
    top: var(--bosluk-3);
    right: var(--bosluk-3);
    width: min(230px, calc(100% - var(--bosluk-6)));
    background: var(--renk-demo-kart);
    border-radius: var(--kose-cip);
    padding: var(--bosluk-3) var(--bosluk-4);
    font-size: 0.75rem;
    box-shadow: 0 12px 32px rgb(10 25 19 / 0.45);
  }
  .bilgi-baslik {
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--renk-metin);
    padding-bottom: var(--bosluk-2);
    border-bottom: 1px solid var(--renk-cizgi);
    margin-bottom: var(--bosluk-2);
  }
  .bilgi-nokta {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--renk-cta);
    flex-shrink: 0;
  }
  .bilgi-karti dl {
    margin: 0;
  }
  .bilgi-karti .satir {
    display: flex;
    justify-content: space-between;
    gap: var(--bosluk-3);
    padding-block: 3px;
  }
  .bilgi-karti dt {
    color: var(--renk-metin-silik);
  }
  .bilgi-karti dd {
    margin: 0;
    font-weight: 600;
    color: var(--renk-metin);
    text-align: right;
  }

  /* ---- genel: arama + araçlar + durum çubuğu ---- */
  .arama {
    position: absolute;
    top: var(--bosluk-3);
    left: var(--bosluk-3);
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    background: var(--renk-harita-yuzey);
    border: 1px solid var(--renk-harita-cizgi);
    border-radius: 999px;
    padding: var(--bosluk-2) var(--bosluk-4);
    font-size: 0.75rem;
    color: var(--renk-harita-metin-soluk);
    max-width: calc(100% - var(--bosluk-8));
    white-space: nowrap;
    overflow: hidden;
  }
  .arama svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--renk-katman-1);
  }
  .araclar {
    position: absolute;
    top: var(--bosluk-3);
    right: var(--bosluk-3);
    display: flex;
    flex-direction: column;
    background: var(--renk-harita-yuzey);
    border: 1px solid var(--renk-harita-cizgi);
    border-radius: var(--kose-kucuk);
    overflow: hidden;
  }
  .araclar span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--renk-harita-metin);
  }
  .araclar span:first-child {
    border-bottom: 1px solid var(--renk-harita-cizgi);
  }
  .durum {
    display: flex;
    align-items: center;
    gap: var(--bosluk-5);
    padding: var(--bosluk-2) var(--bosluk-4);
    border-top: 1px solid var(--renk-harita-cizgi);
    font-size: 0.72rem;
    color: var(--renk-harita-metin-soluk);
  }
  .durum-guncel {
    display: inline-flex;
    align-items: center;
    gap: var(--bosluk-1);
  }
  .durum-nokta {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--renk-katman-1);
  }
  .olcek {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--bosluk-2);
  }
  .olcek-cizgi {
    width: 44px;
    height: 4px;
    border: 1px solid var(--renk-harita-metin-soluk);
    border-top: none;
  }

  @media (min-width: 640px) {
    /* yalnızca katmanlar varyantında iki sütun (panel + harita) */
    .govde.panelli {
      grid-template-columns: 200px 1fr;
    }
    .panel {
      border-bottom: none;
      border-right: 1px solid var(--renk-harita-cizgi);
    }
  }
</style>
