---
// Onaylı hero taslağının (taslaklar/hero-taslak.html) bileşen hâli.
// Taslaktaki kopya token'lar atıldı — tüm değerler gerçek tokens.css'ten gelir.
import { rakamlar } from "../data/rakamlar.js";
import heroSehir from "../assets/img/hero-sehir.webp";

// Kural 9: rakam metne gömülmez — katman sayısı rakamlar.js'ten çekilir.
const katmanSayisi = rakamlar.find((r) => r.etiket.includes("katman"))?.deger;
---

<section class="hero">
  <div class="hero-icerik">
    <span class="ustbaslik">Coğrafi Bilgi Sistemi</span>
    <h1>Şehrin tüm altyapısı <span class="vurgulu">tek haritada</span></h1>
    <p>
      <strong>Su, kanalizasyon, imar, numarataj</strong> — dağınık dosyalarda
      duran her şey tek bir sorgulanabilir kent haritasında birleşir.
    </p>
    <div class="butonlar">
      <a class="btn btn-birincil" href="/ozellikler">Özellikleri İncele</a>
      <a class="btn btn-ikincil" href="/hakkinda#iletisim">İletişime Geç</a>
    </div>

    <div class="harita-kart">
      <div class="bar"><span class="nokta"></span> Kent Haritası · {katmanSayisi} katman</div>
      <img
        src={heroSehir.src}
        width={heroSehir.width}
        height={heroSehir.height}
        alt="Katmanlara ayrılmış stilize üç boyutlu kent haritası — bölgeler ulaşım, altyapı ve çevre katmanlarını temsil eden renklerle ayrılıyor"
      />
    </div>
  </div>
</section>

<style>
  /* Amber ışıma yalnızca hero'da; ince ızgara deseni global.css'te (body) */
  .hero {
    background: radial-gradient(
      700px 380px at 50% -5%,
      var(--renk-parlama-acik),
      transparent 70%
    );
  }

  .hero-icerik {
    max-width: var(--icerik-genislik);
    margin: 0 auto;
    padding: var(--bosluk-8) var(--bosluk-4);
    text-align: center;
  }

  .ustbaslik {
    display: inline-flex;
    align-items: center;
    gap: var(--bosluk-3);
    color: var(--renk-vurgu);
    font-size: var(--boyut-kucuk);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--bosluk-5);
  }
  .ustbaslik::before,
  .ustbaslik::after {
    content: "";
    width: 1.75rem;
    height: 1px;
    background: var(--renk-vurgu);
    opacity: 0.5;
  }

  h1 {
    font-weight: 600;
    letter-spacing: -0.01em;
    max-width: 22ch;
    margin: 0 auto var(--bosluk-5);
  }
  h1 .vurgulu {
    color: var(--renk-vurgu);
    font-style: italic;
    white-space: nowrap;
  }

  .hero-icerik > p {
    color: var(--renk-metin-soluk);
    font-size: var(--boyut-buyuk);
    max-width: 52ch;
    margin: 0 auto var(--bosluk-6);
  }
  .hero-icerik > p strong {
    color: var(--renk-metin);
    font-weight: 600;
  }

  .butonlar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--bosluk-3);
    margin-bottom: var(--bosluk-7);
  }
  .btn {
    display: inline-block;
    padding: var(--bosluk-3) var(--bosluk-6);
    border-radius: var(--kose-kucuk);
    font-weight: 600;
    text-decoration: none;
  }
  .btn-birincil {
    background: var(--renk-cta);
    color: var(--renk-metin);
  }
  .btn-birincil:hover {
    background: var(--renk-cta-koyu);
    color: var(--renk-metin);
  }
  .btn-ikincil {
    border: 1px solid var(--renk-metin-soluk);
    color: var(--renk-metin);
  }
  .btn-ikincil:hover {
    border-color: var(--renk-vurgu);
    color: var(--renk-vurgu);
  }

  /* Harita kartı — korunan koyu blok, krem sahnede vitrin gibi */
  .harita-kart {
    max-width: 56rem;
    margin: 0 auto;
    text-align: left;
    background: var(--renk-harita-yuzey);
    border: 1px solid var(--renk-harita-cizgi);
    border-radius: var(--kose);
    box-shadow: 0 30px 70px rgb(30 42 36 / 0.28);
    overflow: hidden;
  }
  .harita-kart .bar {
    display: flex;
    align-items: center;
    gap: var(--bosluk-2);
    padding: var(--bosluk-3) var(--bosluk-4);
    border-bottom: 1px solid var(--renk-harita-cizgi);
    color: var(--renk-harita-metin-soluk);
    font-size: var(--boyut-kucuk);
  }
  .nokta {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--renk-katman-1);
  }
  /* Görsel dikey kırpılır (object-fit: cover); üstteki %20 odak üç konum
     iğnesini de kadrajda tutar. Kenar boşlukları görselin kendi zemin
     rengiyle doldurulur ki kırpım belli olmasın. */
  .harita-kart img {
    display: block;
    width: 100%;
    height: clamp(320px, 46vw, 600px);
    object-fit: cover;
    object-position: center 20%;
    background: var(--renk-hero-gorsel-zemin);
  }

  @media (min-width: 900px) {
    .hero-icerik {
      padding-top: var(--bosluk-9);
    }
  }
</style>
