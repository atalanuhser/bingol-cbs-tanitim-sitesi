---
// Ortak sayfa iskeleti: head + header + footer.
// Her sayfa benzersiz title ve description göndermek ZORUNDA (kalite çıtası).
import "../styles/fontlar.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description } = Astro.props;

// SEO/OG: mutlak adresler astro.config.mjs'teki `site` değerinden türetilir.
// OG görseli 1200×630; paylaşım platformlarının WebP desteği tutarsız
// olduğundan bu tek görsel bilinçli olarak JPG'dir (kural 7'nin istisnası).
const kanonik = new URL(Astro.url.pathname, Astro.site);
const ogGorsel = new URL("/og-gorsel.jpg", Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={kanonik} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph (paylaşım kartları) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Piramittek CBS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={ogGorsel} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Katmanlara ayrılmış üç boyutlu kent haritasıyla coğrafi bilgi sistemi tanıtımı" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />

    <main id="icerik">
      <slot />
    </main>

    <Footer />
  </body>
</html>
